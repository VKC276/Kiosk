{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vkc-kiosk",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/healthz", "/ws"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "DEFAULT_KIOSK_ID": "reception"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vkc-kiosk",
      "database_id": "934a0447-8ce7-44db-b451-b99d46bb769c",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "KIOSK_HUB",
        "class_name": "KioskHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["KioskHub"]
    }
  ]
}
