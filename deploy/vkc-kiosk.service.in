[Unit]
Description=VKC Kiosk (kortläsare mot Cloudflare, eller lokal Flask)
Documentation=https://github.com/VKC276/Kiosk
Requires=network-online.target
After=network-online.target
Wants=systemd-udev-settle.service
After=systemd-udev-settle.service

[Service]
Type=simple
User=__KIOSK_USER__
Group=__KIOSK_USER__
WorkingDirectory=__KIOSK_DIR__
Environment=PATH=__KIOSK_DIR__/venv/bin:/usr/local/bin:/usr/bin
ExecStartPre=/usr/bin/sleep 3
ExecStart=__KIOSK_DIR__/scripts/start-kiosk-backend.sh
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SupplementaryGroups=input

[Install]
WantedBy=multi-user.target
