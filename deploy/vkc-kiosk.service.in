[Unit]
Description=VKC Kiosk kortläsar-agent (Cloudflare)
Documentation=https://github.com/VKC276/Kiosk
Requires=network-online.target
After=network-online.target
Wants=systemd-udev-settle.service
After=systemd-udev-settle.service

[Service]
Type=simple
User=__KIOSK_USER__
Group=__KIOSK_USER__
WorkingDirectory=__KIOSK_DIR__
Environment=PATH=__KIOSK_DIR__/venv/bin:/usr/local/bin:/usr/bin
ExecStartPre=/usr/bin/sleep 3
ExecStart=__KIOSK_DIR__/scripts/start-kiosk-backend.sh
Restart=always
RestartSec=3
# Snabb power-off: default TimeoutStopSec (~90 s) gjorde avstängning seg
# när läsartråd/HTTP hängde. Efter timeout → SIGKILL.
TimeoutStopSec=8
KillMode=mixed
StandardOutput=journal
StandardError=journal
SupplementaryGroups=input

[Install]
WantedBy=multi-user.target
