[Unit]
Description=VKC Kiosk + MIFARE-kortläsare
Requires=network-online.target
After=network-online.target
Wants=systemd-udev-settle.service
After=systemd-udev-settle.service

[Service]
User=vkc
WorkingDirectory=/home/vkc/mifare-reader
ExecStartPre=/usr/bin/sleep 5
# En worker: kortläsare + cache ska bara köras en gång.
# gevent + --timeout 0 behövs för stabil SSE.
ExecStart=/home/vkc/mifare-reader/venv/bin/gunicorn \
  -w 1 \
  -k gevent \
  --timeout 0 \
  -b 0.0.0.0:8081 \
  wsgi:app
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
Environment=PATH=/home/vkc/mifare-reader/venv/bin

[Install]
WantedBy=multi-user.target
